<?xml version="1.0" encoding="UTF-8"?>
<!-- Aperçu de style pour la minimap du Launcher 208 : couleurs (GPS classique) -->
<rendertheme xmlns="http://mapsforge.org/renderTheme" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"
    version="5" map-background="#F2EFE9" map-background-outside="#F2EFE9">

    <rule e="way" k="natural" v="issea|sea"><area fill="#A8D2F4" /></rule>
    <rule e="way" k="natural" v="nosea"><area fill="#F2EFE9" stroke="#F2EFE9" stroke-width="1.0" /></rule>
    <rule e="way" k="leisure|landuse|natural" v="park|garden|recreation_ground|village_green|grass|meadow|grassland|cemetery|allotments|scrub|heath" zoom-min="10">
        <area fill="#CDEBC0" />
    </rule>
    <rule e="way" k="landuse|natural" v="forest|wood" zoom-min="10"><area fill="#BCDFAB" /></rule>
    <rule e="way" k="natural|landuse|waterway" v="water|reservoir|basin|riverbank"><area fill="#A8D2F4" /></rule>
    <rule e="way" k="waterway" v="river|canal"><line stroke="#A8D2F4" stroke-width="2.4" /></rule>
    <rule e="way" k="waterway" v="stream" zoom-min="14"><line stroke="#A8D2F4" stroke-width="0.9" /></rule>
    <rule e="way" k="building" v="*" zoom-min="16"><area fill="#E4DED4" stroke="#D5CEC2" stroke-width="0.6" /></rule>
    <rule e="way" k="railway" v="rail" zoom-min="12"><line stroke="#C9C3B8" stroke-width="0.9" stroke-linecap="butt" /></rule>

    <rule e="way" k="area" v="~|no|false">
        <rule e="way" k="highway" v="*">
            <rule e="way" k="highway" v="service|track" zoom-min="15"><line stroke="#D9D2C5" stroke-width="2.0" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="residential|unclassified|living_street|road|pedestrian" zoom-min="13"><line stroke="#D9D2C5" stroke-width="3.2" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="tertiary|tertiary_link|secondary|secondary_link" zoom-min="11"><line stroke="#E2CC86" stroke-width="4.5" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="primary|primary_link|trunk|trunk_link"><line stroke="#DDA849" stroke-width="5.6" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="motorway|motorway_link"><line stroke="#D4823C" stroke-width="6.2" stroke-linecap="round" /></rule>

            <rule e="way" k="highway" v="service|track" zoom-min="15"><line stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="residential|unclassified|living_street|road|pedestrian" zoom-min="13"><line stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="tertiary|tertiary_link|secondary|secondary_link" zoom-min="11"><line stroke="#FFF3C4" stroke-width="3.6" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="primary|primary_link|trunk|trunk_link"><line stroke="#FFD37E" stroke-width="4.6" stroke-linecap="round" /></rule>
            <rule e="way" k="highway" v="motorway|motorway_link"><line stroke="#F6A55E" stroke-width="5.2" stroke-linecap="round" /></rule>

            <rule e="way" k="highway" v="residential|unclassified|living_street|road|tertiary|secondary|primary|trunk" zoom-min="15">
                <pathText k="name" font-size="12" font-style="bold" fill="#30343A" stroke="#FFFFFF" stroke-width="3.0" />
            </rule>
        </rule>
    </rule>

    <rule e="node" k="place" v="city|town" zoom-max="14">
        <caption k="name" font-size="15" font-style="bold" fill="#30343A" stroke="#FFFFFF" stroke-width="3.0" />
    </rule>
    <rule e="node" k="place" v="village|suburb" zoom-min="12" zoom-max="15">
        <caption k="name" font-size="13" font-style="bold" fill="#5A6068" stroke="#FFFFFF" stroke-width="3.0" />
    </rule>
</rendertheme>
